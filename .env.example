# Network: mainnet | testnet
ZCASH_NETWORK=testnet
LIGHTWALLETD_URL=

# Detector: incoming viewing keys ONLY
VOTING_IVK=
AUCTION_IVK=

# Sidecar (holds spend keys for refunds/payouts; keep balance small)
SIDECAR_WALLET_DIR=./wallet
SIDECAR_PORT=8402

# Agent
ANTHROPIC_API_KEY=
IMAGE_PROVIDER=
IMAGE_API_KEY=
ARTIST_SIGNING_KEY_PATH=./wallet/artist.key

# Round policy (hard bounds the agent cannot exceed)
PIECES_MIN=2
PIECES_MAX=6
MIN_VOTE_ZAT=100000
MIN_WHISPER_ZAT=100000
RESERVE_MIN_ZAT=1000000
RESERVE_MAX_ZAT=100000000
VOTING_BLOCKS=48
AUCTION_BLOCKS=48
CONFIRMATIONS=1

# Refunds: flat fee deducted per refund (ZIP-317: 2 actions x 5000 zat; confirm in spike)
REFUND_FEE_ZAT=10000

# Treasury survival: estimated spend per day (compute + images), for runway
DAILY_SPEND_ZAT=500000

# Use the mock chain until the detector works
USE_MOCK_CHAIN=true
