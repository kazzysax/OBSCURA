# Network: mainnet | testnet
ZCASH_NETWORK=testnet
LIGHTWALLETD_URL=

# Detector: incoming viewing keys ONLY (used once the real sidecar backend lands)
VOTING_IVK=
AUCTION_IVK=

# Sidecar (holds spend keys for refunds/payouts; keep balance small)
SIDECAR_BACKEND=dev
SIDECAR_WALLET_DIR=./wallet
SIDECAR_PORT=8402
# SIDECAR_URL=http://127.0.0.1:8402

# Storage
OBSCURA_DB=./data/obscura.sqlite
GENERATED_DIR=./generated

# Agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
IMAGE_PROVIDER=
IMAGE_API_KEY=
ARTIST_SIGNING_KEY_PATH=./wallet/artist.key

# Round policy (hard bounds the agent cannot exceed)
PIECES_MIN=2
PIECES_MAX=6
MIN_VOTE_ZAT=100000
MIN_WHISPER_ZAT=100000
RESERVE_MIN_ZAT=1000000
RESERVE_MAX_ZAT=100000000
# Mainnet blocks are 75 s until NU7 (target 2026-11-05); testnet is already 25 s.
VOTING_BLOCKS=48
AUCTION_BLOCKS=48
CONFIRMATIONS=1

# Refunds: flat fee deducted per refund (ZIP-317: 2 actions x 5000 zat; confirm in spike)
REFUND_FEE_ZAT=10000
# Outputs per refund transaction (stay well under ZIP-218 action limits)
REFUND_BATCH_SIZE=5

# Treasury survival: estimated spend per day (compute + images), for runway
DAILY_SPEND_ZAT=500000
# Cost booked per round; below this the artist goes dormant (defaults to DAILY_SPEND_ZAT)
ROUND_COST_ZAT=

# Use the mock chain until the sidecar's real backend works
USE_MOCK_CHAIN=true
# Mock chain only: seconds per block, and simulated patrons
MOCK_BLOCK_SECONDS=5
MOCK_AUTOPILOT=false
