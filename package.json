{
  "name": "obscura",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r --filter=!@obscura/web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "demo": "node --experimental-strip-types --no-warnings packages/artist/src/cli.ts demo",
    "web": "pnpm --filter @obscura/web dev"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
